# ExpressVPN MANUAL CONFIGURATION credentials (OpenVPN).
# These are NOT your ExpressVPN account email and password.
# Get them at: expressvpn.com > sign in > "Set up on more devices" > "Manual Configuration" > OpenVPN.
# Copy this file to .env.expressvpn and put the two values in .env.expressvpn. Do not commit .env.expressvpn.
OPENVPN_USER=REPLACE_WITH_USERNAME
OPENVPN_PASSWORD=REPLACE_WITH_PASSWORD

# The VPN protocol. ExpressVPN supports only openvpn in Gluetun.
VPN_TYPE=openvpn
